{
  "name": "cowlendar-website",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-pages.mjs",
    "dev": "wrangler pages dev dist --d1 BLOG_DB=local-cowlendar-blog --compatibility-date=2026-09-22",
    "test": "node --test checks/*.test.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply cowlendar-blog --local --config wrangler.local.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply cowlendar-blog --remote"
  },
  "devDependencies": {
    "wrangler": "4.136.2",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.3"
  }
}
