{
  "name": "cowlendar-website",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-pages.mjs",
    "dev": "wrangler pages dev dist",
    "test": "node --test checks/*.test.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply cowlendar-blog --local",
    "db:migrate:remote": "wrangler d1 migrations apply cowlendar-blog --remote"
  },
  "devDependencies": {
    "@fullhuman/postcss-purgecss": "^8.0.0",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.3",
    "esbuild": "^0.25.12",
    "html-minifier-terser": "^7.2.0",
    "marked": "^18.0.14",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.4",
    "turndown": "^7.2.4",
    "wrangler": "4.136.2"
  }
}
